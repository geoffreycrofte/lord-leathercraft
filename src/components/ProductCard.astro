---
/**
 * A tool or supply card: photo, optional chip, name, description, secondary
 * links, then the shop buttons. Used by the tools page and the beginner
 * guides, so a product looks the same everywhere.
 */
import { Image } from 'astro:assets';
import OfferLink from './OfferLink.astro';
import type { Product } from '../data/kits';
import { offerUrl } from '../data/tools';
import type { Lang } from '../i18n/ui';
import { isAffiliateUrl } from '../lib/remark-affiliate-links.mjs';

interface Props {
  product: Product;
  lang: Lang;
  headingLevel?: 3 | 4;
  chip?: string;
}

const { product, lang, headingLevel = 3, chip } = Astro.props;
const Heading = `h${headingLevel}` as const;
---

<article class="product">
  <Image
    class="product__photo"
    src={product.image}
    alt={product.alt[lang]}
    widths={[400, 800]}
    sizes="(min-width: 75rem) 22rem, (min-width: 40rem) 45vw, 100vw"
  />
  {chip && <span class="chip">{chip}</span>}
  <Heading class="product__name">{product.name[lang]}</Heading>
  <p>{product.description[lang]}</p>
  {
    product.links && product.links.length > 0 && (
      <ul class="product__links" role="list">
        {product.links.map((l) => {
          const url = offerUrl({ shop: '', url: l.url, asin: l.asin }, lang);
          return (
          <li>
            <a href={url} rel={isAffiliateUrl(url) ? 'sponsored noopener' : undefined}>
              {l.label[lang]}
            </a>
          </li>
          );
        })}
      </ul>
    )
  }
  {
    product.offers.length > 0 && (
      <div class="product__offers">
        {product.offers.map((o) => (
          <OfferLink lang={lang} url={offerUrl(o, lang)} label={o.label?.[lang] ?? o.shop} code={o.code} />
        ))}
      </div>
    )
  }
</article>

<style>
  .product {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
    height: 100%;
    padding: 1.25rem 1.375rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--color-bg);
  }
  .product__photo {
    width: calc(100% + 2.75rem);
    max-width: none;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    margin: -1.25rem -1.375rem 0.25rem;
    border-radius: var(--radius) var(--radius) 0 0;
  }
  .product__name {
    margin: 0.25rem 0 0;
    font-size: 1.1875rem;
  }
  .product p {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 1rem;
  }
  .product__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.875rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.9375rem;
  }
  .product__offers {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
    margin-top: auto;
    padding-top: 0.5rem;
  }
  /* Narrow cards: long labels wrap on two lines. */
  .product__offers :global(.button) {
    flex-wrap: wrap;
    column-gap: 0.375rem;
    row-gap: 0;
    padding: 0.375rem 1rem;
    border-radius: 1.375rem;
    overflow-wrap: normal;
  }
</style>
