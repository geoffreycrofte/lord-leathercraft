---
import { shopCollections, type CollectionKey } from '../data/site';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  keys: CollectionKey[];
}

const { lang, keys } = Astro.props;
const t = useTranslations(lang);
---

{
  keys.length > 0 && (
    <section class="related stitch" aria-labelledby="related-title">
      <h2 id="related-title">{t('article.related')}</h2>
      <p>{t('external.newShop')}</p>
      <ul>
        {keys.map((key) => (
          <li>
            <a href={shopCollections[key].url} hreflang="en">
              {shopCollections[key][lang]}
            </a>
          </li>
        ))}
      </ul>
    </section>
  )
}

<style>
  .related {
    max-width: var(--measure);
    margin-top: var(--space-l);
    padding: var(--space-m);
    background: var(--primary-050);
    border: 1px solid var(--primary-100);
    color: var(--primary-700);
    border-radius: var(--radius);
  }
  h2 {
    margin-top: 0;
    font-size: 1.625rem;
  }
  ul {
    margin: 0;
  }
  p,
  ul {
    position: relative;
    color: var(--color-text);
  }
</style>
