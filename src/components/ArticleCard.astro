---
import { Image } from 'astro:assets';
import CategoryChip from './CategoryChip.astro';
import { guidePath } from '../i18n/ui';
import type { Article } from '../lib/articles';

interface Props {
  article: Article;
  headingLevel: 2 | 3;
}

const { article, headingLevel } = Astro.props;
const { data } = article;
const Heading = `h${headingLevel}` as const;
---

<article class:list={['card', 'zoom-media', { 'card--dark': !data.cover }]}>
  <div class="card__body">
    <CategoryChip lang={data.lang} category={data.category} />
    <Heading class="card__title">
      <a href={guidePath(data.lang, data.slug)}>{data.title}</a>
    </Heading>
    <p>{data.description}</p>
  </div>
  {data.cover && <Image src={data.cover} alt="" widths={[480, 800]} sizes="(min-width: 40rem) 24rem, 100vw" />}
</article>

<style>
  .card {
    position: relative;
    height: 100%;
    display: flex;
    flex-direction: column;
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    overflow: hidden;
    transition: transform 0.2s;
  }
  .card:hover {
    transform: translateY(-2px);
  }
  .card :global(img) {
    order: -1;
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }
  .card__body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.625rem;
    padding: 1.375rem 1.5rem 1.625rem;
    flex-grow: 1;
  }
  .card__title {
    margin: 0;
    font-size: 1.375rem;
  }
  .card__title a {
    color: var(--color-text);
    text-decoration: none;
  }
  /* Whole card clickable; the link text stays the title. */
  .card__title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .card:has(a:focus-visible) {
    outline: 3px solid var(--color-focus);
    outline-offset: 3px;
  }
  .card__title a:focus-visible {
    outline: none;
  }
  .card:hover .card__title a {
    text-decoration: underline;
    text-decoration-thickness: 0.08em;
  }
  .card p {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 1rem;
  }
  /* No cover: typographic card on deep teal. */
  .card--dark {
    min-height: 26rem;
    justify-content: flex-end;
    background: var(--accent-700);
    border-color: var(--accent-700);
  }
  .card--dark .card__title {
    font-size: 1.75rem;
  }
  .card--dark .card__title a {
    color: #fff;
  }
  .card--dark p {
    color: var(--accent-100);
  }
  .card--dark:has(a:focus-visible) {
    outline-color: var(--color-focus);
  }
</style>
