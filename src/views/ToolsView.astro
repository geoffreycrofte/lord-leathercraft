---
import BaseLayout from '../layouts/BaseLayout.astro';
import AffiliateNotice from '../components/AffiliateNotice.astro';
import ProductCard from '../components/ProductCard.astro';
import PageIntro from '../components/PageIntro.astro';
import { offerUrl, tasks, tiers, tools, type Tool } from '../data/tools';
import { guidePath, routes, type Lang } from '../i18n/ui';
import { isAffiliateUrl } from '../lib/remark-affiliate-links.mjs';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const copy = {
  en: {
    title: 'My tools',
    accent: 'from first cut to pro',
    description: 'The leathercraft tools I use, from a beginner’s kit to professional machines, sorted by level and task, with where to buy them.',
    intro: 'You do not need everything to start. Begin with the basics, then add tools when a project asks for them.',
    budget:
      'The whole list below costs around $450. To spend less, start with the tools the pattern you want to make really needs, and upgrade the ones you use the most later. Prices change too often, so I do not list them.',
    beginnerGuides: 'Making a first belt or wallet? My beginner guides list the tools for each project:',
    belt: 'Guide and tools to make a leather belt',
    wallet: 'Guide and tools to make leather wallets',
    leatherTitle: 'And the leather?',
    leatherText: 'Look first for a tannery near you: touching the leather and asking a professional for advice is the best way to choose. If you have none nearby, here are the online shops I buy from.',
    leatherLink: 'Where to buy quality leather',
    guidesLink: 'New to leathercraft? Start with the guides.',
  },
  fr: {
    title: 'Mes outils',
    accent: 'de la première découpe au pro',
    description: 'Les outils de maroquinerie que j’utilise, du kit débutant aux machines pro, classés par niveau et par tâche, avec où les acheter.',
    intro: 'Pas besoin de tout pour commencer. Démarrez avec les bases, puis ajoutez des outils quand un projet en a besoin.',
    budget:
      'La liste complète représente environ 450 $. Pour dépenser moins, commencez par les outils dont le patron que vous voulez réaliser a vraiment besoin, et remplacez plus tard ceux qui vous servent le plus. Les prix changent trop souvent, donc je ne les indique pas.',
    beginnerGuides: 'Vous préparez une première ceinture ou un premier portefeuille ? Mes guides débutants listent les outils de chaque projet :',
    belt: 'Guide et outils pour fabriquer une ceinture en cuir',
    wallet: 'Guide et outils pour fabriquer des portefeuilles en cuir',
    leatherTitle: 'Et le cuir ?',
    leatherText: 'Cherchez d’abord une tannerie près de chez vous : toucher le cuir et demander conseil à un professionnel reste la meilleure façon de choisir. Sinon, voici les boutiques en ligne où j’achète le mien.',
    leatherLink: 'Où acheter du cuir de qualité',
    guidesLink: 'Vous débutez ? Commencez par les guides.',
  },
}[lang];

const tierKeys = Object.keys(tiers) as Tool['tier'][];
const hasAffiliate = tools.some((tool) => tool.offers.some((o) => isAffiliateUrl(offerUrl(o, lang))));
---

<BaseLayout lang={lang} title={copy.title} description={copy.description} alternates={routes.tools}>
  <div class="container">
    <PageIntro title={copy.title} accent={copy.accent} intro={copy.intro}>
      <p class="tools__guides"><a href={routes.guides[lang]}>{copy.guidesLink}</a></p>
    </PageIntro>
    {hasAffiliate && <AffiliateNotice lang={lang} />}
    <div class="tools__intro prose">
      <p>{copy.budget}</p>
      <p>{copy.beginnerGuides}</p>
      <ul>
        <li><a href={guidePath(lang, lang === 'en' ? 'leather-belt-making-guide' : 'guide-ceinture-cuir')}>{copy.belt}</a></li>
        <li><a href={guidePath(lang, lang === 'en' ? 'leather-wallet-making-guide' : 'guide-portefeuille-cuir')}>{copy.wallet}</a></li>
      </ul>
    </div>

    {
      tierKeys.map((tier, i) => (
        <section class="tier" aria-labelledby={`tier-${tier}`}>
          <div class="tier__head">
            <span class="tier__step stitch" aria-hidden="true">{i + 1}</span>
            <div>
              <h2 id={`tier-${tier}`}>{tiers[tier][lang].title}</h2>
              <p class="muted">{tiers[tier][lang].intro}</p>
            </div>
          </div>
          <ul class="tools" role="list">
            {tools
              .filter((tool) => tool.tier === tier)
              .map((tool) => (
                <li>
                  <ProductCard product={tool} lang={lang} chip={tasks[tool.task][lang]} />
                </li>
              ))}
          </ul>
        </section>
      ))
    }

    <section class="tools__leather stitch" aria-labelledby="tools-leather">
      <h2 id="tools-leather">{copy.leatherTitle}</h2>
      <p>{copy.leatherText}</p>
      <p><a class="button" href={guidePath(lang, lang === 'en' ? 'where-to-buy-leather' : 'ou-acheter-du-cuir')}>{copy.leatherLink}</a></p>
    </section>
  </div>
</BaseLayout>

<style>
  .tools__intro {
    margin-bottom: var(--space-m);
  }
  .tools__leather {
    margin-block: var(--space-l) 0;
    padding: var(--space-m);
    border-radius: var(--radius);
    background: var(--primary-050);
  }
  .tools__leather h2 {
    margin-top: 0;
  }
  .tools__leather p {
    max-width: 65ch;
  }
  .tools__guides {
    margin: var(--space-s) 0 0;
    font-weight: 600;
  }
  .tier {
    padding-block: var(--space-l);
    border-top: 2px dashed var(--neutral-200);
  }
  .tier__head {
    display: flex;
    gap: var(--space-m);
    align-items: flex-start;
    margin-bottom: var(--space-m);
  }
  .tier__head h2 {
    margin: 0 0 0.25rem;
  }
  .tier__head p {
    margin: 0;
  }
  .tier__step::after {
    inset: 0.25rem;
    border-radius: 50%;
  }
  .tier__step {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: var(--radius-pill);
    background: var(--primary-100);
    color: var(--primary-700);
    font-family: var(--font-heading);
    font-weight: 900;
    font-size: 1.375rem;
  }
  .tools {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
    gap: var(--space-s);
    list-style: none;
    margin: 0;
    padding: 0;
  }
</style>
