---
/**
 * Privacy-friendly YouTube embed: nothing is requested from YouTube until the
 * visitor presses play. Without JavaScript, a plain link remains.
 *
 * The poster is the video thumbnail, downloaded at build time into
 * src/assets/videos by scripts/fetch-youtube-posters.mjs, unless a `poster`
 * is given.
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  id: string;
  title: string;
  lang: Lang;
  /** Local poster image (no request to YouTube for thumbnails). */
  poster?: ImageMetadata;
}

const thumbnails = import.meta.glob<{ default: ImageMetadata }>('../assets/videos/*.jpg', { eager: true });
const { id, title, lang } = Astro.props;
const poster = Astro.props.poster ?? thumbnails[`../assets/videos/${id}.jpg`]?.default;
const t = useTranslations(lang);
const watchUrl = `https://www.youtube.com/watch?v=${id}`;
---

<figure class="video">
  <div class="video__frame" data-video-id={id} data-video-title={title}>
    {poster && <Image src={poster} alt="" widths={[640, 1280]} sizes="(min-width: 75rem) 70ch, 100vw" />}
    <button type="button" class="video__play" hidden>
      <span class="video__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="28" height="28"><path d="M8 5.5v13l10.5-6.5z" fill="currentColor" /></svg>
      </span>
      <span class="visually-hidden">{t('video.play')}: {title}</span>
    </button>
  </div>
  <figcaption>
    {title}. {t('video.notice')} <a href={watchUrl}>{t('video.watchOn')}</a>.
  </figcaption>
</figure>

<script>
  document.querySelectorAll<HTMLElement>('.video__frame').forEach((frame) => {
    const button = frame.querySelector<HTMLButtonElement>('.video__play');
    if (!button) return;
    button.hidden = false;
    button.addEventListener('click', () => {
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${frame.dataset.videoId}?autoplay=1`;
      iframe.title = frame.dataset.videoTitle ?? '';
      iframe.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
      iframe.allowFullscreen = true;
      frame.replaceChildren(iframe);
      iframe.focus();
    });
  });
</script>

<style>
  .video {
    margin: var(--space-l) 0;
  }
  .video__frame {
    position: relative;
    aspect-ratio: 16 / 9;
    background: var(--neutral-700);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .video__frame :global(img),
  .video__frame :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border: 0;
  }
  .video__play {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    width: 100%;
    padding: 0;
    border: 0;
    background: linear-gradient(to top, rgb(0 0 0 / 0.35), rgb(0 0 0 / 0.05) 60%);
    color: #fff;
    cursor: pointer;
  }
  .video__play[hidden] {
    display: none;
  }
  .video__icon {
    display: grid;
    place-items: center;
    width: 4.5rem;
    height: 4.5rem;
    padding-left: 0.25rem;
    border-radius: 50%;
    background: var(--primary-500);
    box-shadow:
      0 0 0 0.375rem rgb(255 255 255 / 0.25),
      0 0.5rem 1.5rem rgb(0 0 0 / 0.3);
    transition:
      transform 0.25s,
      background-color 0.25s;
  }
  .video__play:hover .video__icon,
  .video__play:focus-visible .video__icon {
    transform: scale(1.08);
    background: var(--primary-600);
  }
  .video__play:focus-visible {
    outline: 3px solid var(--primary-100);
    outline-offset: -0.5rem;
  }
  @media (prefers-reduced-motion: reduce) {
    .video__icon {
      transition: none;
    }
  }
</style>
