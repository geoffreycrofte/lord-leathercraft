---
import { Image, getImage } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import AffiliateNotice from '../components/AffiliateNotice.astro';
import ArticleCard from '../components/ArticleCard.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import RelatedCollections from '../components/RelatedCollections.astro';
import YouTube from '../components/YouTube.astro';
import { AUTHOR } from '../data/site';
import { formatDate, routes, useTranslations } from '../i18n/ui';
import { getPostAlternates, getRelatedGuides, type Post } from '../lib/posts';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { data } = post;
const lang = data.lang;
const t = useTranslations(lang);
const { Content, remarkPluginFrontmatter } = await render(post);
const alternates = await getPostAlternates(post);
const related = await getRelatedGuides(post);
const site = Astro.site!;
const ogImage = data.cover ? (await getImage({ src: data.cover, width: 1200, format: 'jpg' })).src : undefined;
const crumbs = [
  { label: t('nav.home'), href: routes.home[lang] },
  { label: t('nav.blog'), href: routes.blog[lang] },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: data.title,
    description: data.description,
    inLanguage: lang,
    datePublished: data.pubDate.toISOString(),
    dateModified: (data.updatedDate ?? data.pubDate).toISOString(),
    author: { '@type': 'Person', name: AUTHOR },
    mainEntityOfPage: new URL(alternates[lang], site).href,
    ...(ogImage && { image: new URL(ogImage, site).href }),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [...crumbs, { label: data.title, href: alternates[lang] }].map((c, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: c.label,
      item: new URL(c.href, site).href,
    })),
  },
];
---

<BaseLayout lang={lang} title={data.title} description={data.description} alternates={alternates} ogImage={ogImage} ogType="article" jsonLd={jsonLd}>
  <article class="container post">
    <Breadcrumbs lang={lang} items={crumbs} current={data.title} />
    <header class="prose post__header">
      <span class="chip chip--primary">{t(`kind.${data.kind}`)}</span>
      <h1>{data.title}</h1>
      <p class="post__meta">
        <time datetime={data.pubDate.toISOString().slice(0, 10)}>{formatDate(data.pubDate, lang)}</time>
      </p>
    </header>
    {
      data.cover && (
        <Image class="post__cover" src={data.cover} alt={data.coverAlt ?? ''} widths={[640, 960, 1280]} sizes="(min-width: 75rem) 70ch, 100vw" />
      )
    }
    {remarkPluginFrontmatter.hasAffiliateLinks && <AffiliateNotice lang={lang} />}
    <div class="prose">
      <Content components={{ YouTube }} />
    </div>
    {
      related.length > 0 && (
        <section class="post__related" aria-labelledby="post-related">
          <h2 id="post-related">{t('post.related')}</h2>
          <ul class="post__cards" role="list">
            {related.map((guide) => <li><ArticleCard article={guide} headingLevel={3} /></li>)}
          </ul>
        </section>
      )
    }
    <RelatedCollections lang={lang} keys={data.collections} />
  </article>
</BaseLayout>

<style>
  .post__header {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-s);
  }
  .post__header h1,
  .post__meta {
    margin: 0;
  }
  .post__meta {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
  }
  .post__cover {
    display: block;
    width: 100%;
    max-width: var(--measure);
    height: auto;
    border-radius: var(--radius-l);
    margin-block: var(--space-l) var(--space-m);
  }
  .post__related {
    margin-top: var(--space-xl);
  }
  .post__cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
    gap: 1.75rem;
    list-style: none;
    margin: var(--space-m) 0 0;
    padding: 0;
  }
</style>
