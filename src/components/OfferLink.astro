---
/**
 * Link to a shop or supplier. Affiliate links (detected from the URL) get
 * rel="sponsored", like in articles. The page shows the notice at the top.
 */
import Icon from './Icon.astro';
import { isAffiliateUrl } from '../lib/remark-affiliate-links.mjs';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  url: string;
  label: string;
  code?: string;
}

const { lang, url, label, code } = Astro.props;
const t = useTranslations(lang);
const affiliate = isAffiliateUrl(url);
---

<span class="offer">
  <a class="button button--small button--outline" href={url} rel={affiliate ? 'sponsored noopener' : undefined}>
    {label}
    <Icon name="external" size={14} strokeWidth={2.4} />
  </a>
  {code && <span class="offer__code">{t('offer.code')} <strong>{code}</strong></span>}
</span>

<style>
  .offer {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }
  .offer__code {
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }
  .offer__code strong {
    padding: 0.125rem 0.5rem;
    border: 1px dashed var(--neutral-400);
    border-radius: 0.375rem;
    color: var(--color-text);
    font-family: ui-monospace, monospace;
  }
</style>
