---
import logo from '../assets/logo.svg?raw';
import Icon from './Icon.astro';
import { SHOP_URL } from '../data/site';
import { otherLang, routes, useTranslations, type Lang } from '../i18n/ui';
import type { Alternates } from '../layouts/BaseLayout.astro';

interface Props {
  lang: Lang;
  alternates: Alternates;
}

const { lang, alternates } = Astro.props;
const t = useTranslations(lang);
const target = otherLang(lang);
const switchHref = alternates[target] ?? routes.home[target];
const current = Astro.url.pathname;
const nav = [
  { href: routes.guides[lang], label: t('nav.guides') },
  { href: `${routes.home[lang]}#projects`, label: t('nav.patterns') },
  { href: `${routes.home[lang]}#about`, label: t('nav.about') },
];
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="brand" href={routes.home[lang]}>
      <span class="brand__logo" aria-hidden="true" set:html={logo} />
      <span class="visually-hidden">{t('site.name')}, {t('nav.home')}</span>
    </a>
    <nav aria-label={t('nav.label')}>
      <ul class="nav">
        {
          nav.map((item) => (
            <li>
              <a class="nav__link" href={item.href} aria-current={current.startsWith(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
        <li>
          <a class="nav__lang" href={switchHref} hreflang={target} lang={target}>{t('lang.switch')}</a>
        </li>
        <li>
          <a class="button button--small" href={SHOP_URL} hreflang="en">
            {t('nav.shop')}
            <Icon name="external" size={16} strokeWidth={2.2} />
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    background: #fff;
    border-bottom: 1px solid var(--color-border);
  }
  .site-header__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-s);
    padding-block: var(--space-s);
  }
  .brand {
    display: block;
    border-radius: var(--radius-s);
  }
  .brand__logo {
    display: block;
  }
  .brand__logo :global(svg) {
    display: block;
    width: 4.5rem;
    height: 4.5rem;
  }
  .nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-xs) 1.75rem;
    list-style: none;
    margin: 0;
    padding: 0;
    font-weight: 600;
    font-size: 1rem;
  }
  .nav__link {
    color: var(--color-text);
    text-decoration: none;
  }
  .nav__link:hover,
  .nav__link[aria-current='page'] {
    color: var(--color-text);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 6px;
  }
  .nav__lang {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0 1rem;
    border: 2px solid var(--neutral-200);
    border-radius: var(--radius-pill);
    color: var(--color-text);
    text-decoration: none;
  }
  .nav__lang:hover {
    border-color: var(--neutral-600);
    color: var(--color-text);
  }
</style>
