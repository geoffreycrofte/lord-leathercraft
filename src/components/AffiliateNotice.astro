---
import { routes, useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<aside class="affiliate-notice" aria-label={t('footer.affiliate')}>
  <p>
    {t('affiliate.notice')}
    <a href={routes.affiliate[lang]}>{t('affiliate.learnMore')}</a>.
  </p>
</aside>

<style>
  .affiliate-notice {
    max-width: var(--measure);
    margin-block: var(--space-m);
    padding: var(--space-s);
    border-inline-start: 4px solid var(--color-accent);
    background: var(--color-surface);
    font-size: 0.9375rem;
  }
  p {
    margin: 0;
  }
</style>
