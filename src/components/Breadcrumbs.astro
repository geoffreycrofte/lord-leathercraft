---
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  /** Ancestors of the current page, from the home page. */
  items: { label: string; href: string }[];
  current: string;
}

const { lang, items, current } = Astro.props;
const t = useTranslations(lang);
---

<nav class="breadcrumbs" aria-label={t('breadcrumb.label')}>
  <ol>
    {items.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
    <li aria-current="page">{current}</li>
  </ol>
</nav>

<style>
  .breadcrumbs {
    font-size: 0.9375rem;
    margin-block: var(--space-m);
  }
  ol {
    display: flex;
    flex-wrap: wrap;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  li + li::before {
    content: '/';
    padding-inline: 0.5em;
  }
</style>
